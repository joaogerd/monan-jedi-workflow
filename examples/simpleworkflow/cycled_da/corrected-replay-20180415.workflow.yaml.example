        - "{experiment_dir}/work/mpas/20180415T060000Z/run_mpas.pbs"
        - "{experiment_dir}/work/mpas/20180415T060000Z/.monan-jedi-workflow/mpas-submission.json"

  - name: mpas06_submit
    depends_on: [mpas06_prepare]
    argv: [monan-jedi-workflow, mpas-submit, "{experiment_dir}", --cycle, "2018-04-15T06:00:00Z"]
    outputs:
      required:
        - "{experiment_dir}/work/mpas/20180415T060000Z/.monan-jedi-workflow/mpas-submission.json"

  - name: mpas06_wait
    depends_on: [mpas06_submit]
    argv: [monan-jedi-workflow, mpas-wait, "{experiment_dir}", --cycle, "2018-04-15T06:00:00Z", --poll-seconds, "30"]
    outputs:
      required:
        - "{experiment_dir}/work/mpas/20180415T060000Z/.monan-jedi-workflow/mpas-submission.json"

  - name: mpas06_validate
    depends_on: [mpas06_wait]
    argv: [monan-jedi-workflow, mpas-validate, "{experiment_dir}", --cycle, "2018-04-15T06:00:00Z"]
