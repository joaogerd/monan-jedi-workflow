        - "{experiment_dir}/work/mpas/20180415T120000Z/.monan-jedi-workflow/mpas-submission.json"

  - name: mpas12_submit
    depends_on: [mpas12_prepare]
    argv: [monan-jedi-workflow, mpas-submit, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
    outputs:
