<streams>
<immutable_stream name="input" type="input" io_type="pnetcdf,cdf5"
 filename_template="x1.10242.static.nc" input_interval="initial_only" />
<immutable_stream name="output" type="output" io_type="pnetcdf,cdf5"
 filename_template="x1.10242.init.$Y-$M-$D_$h.$m.$s.nc"
 packages="initial_conds" output_interval="initial_only" clobber_mode="overwrite" />
</streams>
