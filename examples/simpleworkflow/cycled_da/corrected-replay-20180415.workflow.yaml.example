        - "{experiment_dir}/work/jedi/20180415T120000Z/.monan-jedi-workflow/jedi-artifacts.json"
        - "{experiment_dir}/work/jedi/20180415T120000Z/Data/states/mpas.3dvar.2018-04-15_12.00.00.nc"

  - name: jedi12_gate
    depends_on: [jedi12_validate]
    argv: [monan-jedi-workflow, validation-gate, "{experiment_dir}/work/jedi/20180415T120000Z/.monan-jedi-workflow/jedi-validation.json"]
    input_fingerprint: sha256
    inputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T120000Z/.monan-jedi-workflow/jedi-validation.json"

  # -------------------------------------------------------------------------
  # Branches after JEDI12: MPAS12->18 and Obs2IODA18.
  # -------------------------------------------------------------------------
  - name: mpas12_prepare
    depends_on: [jedi12_gate]
    argv: [monan-jedi-workflow, mpas-prepare, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
    inputs:
      required:
        - "{experiment_dir}/mpas.yaml"
        - "{experiment_dir}/work/jedi/20180415T120000Z/Data/states/mpas.3dvar.2018-04-15_12.00.00.nc"
    outputs:
