# DAG de referência da pesquisa.
#
# O arquivo contém somente orquestração. As regras científicas/runtime vivem
# nos três arquivos de domínio do CASE. Os mesmos comandos poderão ser chamados
# por ecFlow/Cylc sem portar lógica científica.

workflow:
  name: monan_jedi_cycled_da_reference

context:
  experiment_dir: /p/projetos/monan_das/USUARIO/projects/monan-jedi-workflow/cases/3dfgat_x1.10242

cycle:
  start: "2018-04-15T00:00:00Z"
  end: "2018-04-17T00:00:00Z"
  step: PT6H

tasks:
  - name: obs_doctor
    argv: [monan-jedi-workflow, obs2ioda-doctor, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: obs_prepare
    depends_on: [obs_doctor]
    argv: [monan-jedi-workflow, obs2ioda-prepare, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: obs_run
    depends_on: [obs_prepare]
    argv: [monan-jedi-workflow, obs2ioda-run, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: obs_validate
    depends_on: [obs_run]
    argv: [monan-jedi-workflow, obs2ioda-validate, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: jedi_prepare
    depends_on: [obs_validate]
    argv: [monan-jedi-workflow, jedi-prepare, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: jedi_submit
    depends_on: [jedi_prepare]
    argv: [monan-jedi-workflow, jedi-submit, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: jedi_wait
    depends_on: [jedi_submit]
    argv:
      - monan-jedi-workflow
      - jedi-wait
      - "{experiment_dir}"
      - --cycle
      - "{cycle_time}"
      - --poll-seconds
      - "30"

  - name: jedi_validate
    depends_on: [jedi_wait]
    argv: [monan-jedi-workflow, jedi-validate, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: mpas_prepare
    depends_on: [jedi_validate]
    argv: [monan-jedi-workflow, mpas-prepare, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: mpas_submit
    depends_on: [mpas_prepare]
    argv: [monan-jedi-workflow, mpas-submit, "{experiment_dir}", --cycle, "{cycle_time}"]

  - name: mpas_wait
    depends_on: [mpas_submit]
    argv:
      - monan-jedi-workflow
      - mpas-wait
      - "{experiment_dir}"
      - --cycle
      - "{cycle_time}"
      - --poll-seconds
      - "30"

  - name: mpas_validate
    depends_on: [mpas_wait]
    argv: [monan-jedi-workflow, mpas-validate, "{experiment_dir}", --cycle, "{cycle_time}"]
