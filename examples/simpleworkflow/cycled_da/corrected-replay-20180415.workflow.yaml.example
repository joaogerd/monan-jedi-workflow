        - "{experiment_dir}/jedi.yaml"
        - "{experiment_dir}/work/mpas/20180415T060000Z/mpasout.2018-04-15_09.00.00.nc"
        - "{experiment_dir}/work/mpas/20180415T060000Z/mpasout.2018-04-15_12.00.00.nc"
        - "{experiment_dir}/work/obs/2018041512/sondes_obs_2018041512.h5"
        - "{experiment_dir}/work/obs/2018041512/sfc_obs_2018041512.h5"
        - "{experiment_dir}/work/obs/2018041512/gnssro_obs_2018041512.h5"
    outputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T120000Z/run_jedi.pbs"
        - "{experiment_dir}/work/jedi/20180415T120000Z/.monan-jedi-workflow/jedi-submission.json"

  - name: jedi12_submit
    depends_on: [jedi12_prepare]
    argv: [monan-jedi-workflow, jedi-submit, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
    outputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T120000Z/.monan-jedi-workflow/jedi-submission.json"

  - name: jedi12_wait
