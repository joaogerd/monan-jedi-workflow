site:
  name: jaci
  workspace: /p/projetos/monan_das/$USER
  workflow_root: /p/projetos/monan_das/$USER/projects/monan-jedi-workflow
  work_root: /p/projetos/monan_das/$USER/work/monan-jedi-workflow
  scratch: /p/projetos/monan_das/$USER/scratch/monan-jedi-workflow
  data_root: /p/projetos/monan_das/$USER/data
  external_data_root: /p/projetos/monan_das/$USER/external-inputs/3dvar_fgat
  experiment_root: /p/projetos/monan_das/$USER/scratch/monan-jedi-workflow/experiments

# Cross-repository runtime contract. STACK_ROOT selects the actual spack-stack
# checkout. env_name, env_module, module_root and site_setup come from the
# installed MONAN-JEDI ecosystem contract v2 and are not duplicated here.
stack:
  load: true
  root: ${STACK_ROOT}

# MONAN-JEDI source/build paths are deliberately absent. Consumers receive only
# the stable installed runtime prefix.
jedi:
  install_root: ${MONAN_JEDI_INSTALL_ROOT}

mpi:
  launcher: /opt/cray/pals/1.6/bin/mpiexec
  tasks_flag: -n

runtime:
  unload_anaconda: true
  validate_python: true
  expected_python_abi: "3.11"
