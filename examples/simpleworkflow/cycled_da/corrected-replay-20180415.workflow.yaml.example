        - "{experiment_dir}/work/mpas/20180415T060000Z/mpasout.2018-04-15_09.00.00.nc"
        - "{experiment_dir}/work/mpas/20180415T060000Z/mpasout.2018-04-15_12.00.00.nc"

  - name: mpas06_gate
    depends_on: [mpas06_validate]
    argv: [monan-jedi-workflow, validation-gate, "{experiment_dir}/work/mpas/20180415T060000Z/.monan-jedi-workflow/mpas-validation.json"]
    input_fingerprint: sha256
    inputs:
      required:
        - "{experiment_dir}/work/mpas/20180415T060000Z/.monan-jedi-workflow/mpas-validation.json"

  - name: obs12_doctor
    depends_on: [jedi06_gate]
    argv: [monan-jedi-workflow, obs2ioda-doctor, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
    inputs:
      required:
        - "{experiment_dir}/obs2ioda.yaml"
    outputs:
      required:
        - "{experiment_dir}/work/obs/2018041512/.monan-jedi-workflow/obs2ioda-doctor.json"

  - name: obs12_prepare
    depends_on: [obs12_doctor]
    argv: [monan-jedi-workflow, obs2ioda-prepare, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
    outputs:
      required:
        - "{experiment_dir}/work/obs/2018041512/.monan-jedi-workflow/obs2ioda.json"

  - name: obs12_run
    depends_on: [obs12_prepare]
    argv: [monan-jedi-workflow, obs2ioda-run, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
    outputs:
      required:
        - "{experiment_dir}/work/obs/2018041512/sondes_obs_2018041512.h5"
        - "{experiment_dir}/work/obs/2018041512/sfc_obs_2018041512.h5"
        - "{experiment_dir}/work/obs/2018041512/gnssro_obs_2018041512.h5"

  - name: obs12_validate
    depends_on: [obs12_run]
    argv: [monan-jedi-workflow, obs2ioda-validate, "{experiment_dir}", --cycle, "2018-04-15T12:00:00Z"]
