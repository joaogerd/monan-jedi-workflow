# V2 NMC campaign example. Run with --dry-run before adapting site paths.
case:
  name: nmc_x1_10242_jun2026

model:
  mpas:
    initialization_products:
      root: /path/to/initial-states
      state_template: "{init_yyyymmddhh}/init.{mpas_valid_file_time}.nc"

    initialization:
      run_dir: "runs/mpas/init/{init_yyyymmddhh}"
      argv:
        - /path/to/mpas_init_atmosphere
      resources:
        mpi_ranks: 128
        threads_per_rank: 1
        walltime: "00:30:00"
      validation:
        log: stdout.log
        required_log_markers:
          - "Initialization complete"

    forecast_products:
      root: /path/to/forecast-products
      restart_template: "{init_yyyymmddhh}/f{lead_hours_03d}/restart.{mpas_valid_file_time}.nc"
      state_template: "{init_yyyymmddhh}/f{lead_hours_03d}/mpasout.{mpas_valid_file_time}.nc"

    forecast:
      run_dir: "runs/mpas/forecast/{init_yyyymmddhh}/f{lead_hours_03d}"
      argv:
        - /path/to/mpas_atmosphere
      resources:
        mpi_ranks: 128
        threads_per_rank: 1
        walltime: "01:00:00"
      links:
        - source: "{initial_state}"
          target: "initial_state.nc"
      validation:
        log: stdout.log
        required_log_markers:
          - "Timing for integration"

bmatrix:
  nmc_pairs:
    start_valid_time: "2026-06-22T00:00:00Z"
    end_valid_time: "2026-06-25T00:00:00Z"
    interval_hours: 24
    older_lead_hours: 48
    newer_lead_hours: 24
    minimum_pairs: 4
