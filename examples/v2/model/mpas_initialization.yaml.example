# Example V2 MPAS initialization declaration.
# Paths are illustrative and must be adapted to the selected site profile.
model:
  mpas:
    initialization_products:
      root: /path/to/initial-states
      state_template: "{init_yyyymmddhh}/mpas_init.{mpas_valid_file_time}.nc"

    initialization:
      run_dir: "runs/mpas/init/{init_yyyymmddhh}"
      argv:
        - /path/to/mpas_init_atmosphere
      environment:
        OMP_NUM_THREADS: "1"
      links:
        - source: "inputs/x1.10242.static.nc"
          target: "x1.10242.static.nc"
      templates:
        - source: "inputs/namelist.init_atmosphere.template"
          target: "namelist.init_atmosphere"
      validation:
        log: stdout.log
        required_log_markers:
          - "Initialization complete"
        required_outputs: []
