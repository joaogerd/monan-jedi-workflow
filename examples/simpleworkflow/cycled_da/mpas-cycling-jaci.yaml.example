# Primeiro forecast de cycling validável no JACI: analysis 00Z -> da_state 03Z/06Z.
mpas:
  variables:
    monan_jedi_install_root: ${MONAN_JEDI_INSTALL_ROOT}
    stack_root: ${STACK_ROOT}
    case_root: /p/projetos/monan_das/$USER/work/CASE
    baseline_root: /p/projetos/monan_das/$USER/manual-tests/baseline_bmatrix

  lead_hours: 6
  run_dir: "{case_root}/work/mpas/{cycle_id}"
  forecast_contract:
    run_hours: 6
    da_state_interval_hours: 3
    mpi_ranks: 128
    partition: x1.10242.graph.info.part.128
    do_restart: false
    do_DAcycling: true
    IAU: 'off'
  clean_patterns: ["mpasout.*.nc", "restart.*.nc", "log.atmosphere.*.out"]
  link_directories:
    - source: "{case_root}/runtime-skeleton"
      include: &physics_tables
        [CAM_ABS_DATA.DBL, CAM_AEROPT_DATA.DBL, GENPARM.TBL, LANDUSE.TBL,
         OZONE_DAT.TBL, OZONE_LAT.TBL, OZONE_PLEV.TBL, RRTMG_LW_DATA,
         RRTMG_LW_DATA.DBL, RRTMG_SW_DATA, RRTMG_SW_DATA.DBL, SOILPARM.TBL,
         VEGPARM.TBL]
  links:
    # Deve ser um estado MPAS completo pré-semeado antes da variacional.
    - source: "{case_root}/work/jedi/{cycle_id}/Data/states/mpas.3dvar.{mpas_file_time}.nc"
      target: "mpas.analysis-full.{mpas_file_time}.nc"
    - source: "{monan_jedi_install_root}/bin/mpas_atmosphere"
      target: mpas_atmosphere
    - source: "{baseline_root}/x1.10242.invariant.nc"
      target: x1.10242.invariant.nc
    - source: "{baseline_root}/x1.10242.graph.info.part.128"
      target: x1.10242.graph.info.part.128
  templates:
    - source: templates/namelist.atmosphere.cycling.in
      target: namelist.atmosphere
    - source: templates/streams.atmosphere.cycling.in
      target: streams.atmosphere
  pbs:
    filename: run_mpas.pbs
    job_name: "mpas_cycling_{cycle_yyyymmddhh}"
    queue: pesqmidi
    select: 1
    ncpus: 128
    mpiprocs: 128
    walltime: "02:00:00"
    launcher: /opt/cray/pals/1.6/bin/mpiexec
    bootstrap:
      - "module purge"
      - 'monan_had_nounset=0; case "$-" in *u*) monan_had_nounset=1 ;; esac'
      - "set +u"
      - "pushd {stack_root} >/dev/null"
      - "source configs/sites/tier2/jaci/setup.sh"
      - "popd >/dev/null"
      - 'if [[ "${monan_had_nounset}" == "1" ]]; then set -u; else set +u; fi'
      - "unset monan_had_nounset"
      - "module use {stack_root}/envs/jaci-mpas-jedi-gcc12-craympich/modules"
      - "module load cray-mpich/8.1.31/none/none/jedi-mpas-env/1.0.0"
    command: ["./mpas_atmosphere"]
    environment:
      OMP_NUM_THREADS: "1"
      FI_CXI_RX_MATCH_MODE: hybrid
      GFORTRAN_CONVERT_UNIT: "big_endian:101-200"
      F_UFMTENDIAN: big
  validation:
    log: log.atmosphere.0000.out
    required_log_markers: ["Finished running the atmosphere core"]
    required_outputs:
      - "mpasout.{mpas_t_plus_3_file_time}.nc"
      - "mpasout.{mpas_valid_file_time}.nc"
