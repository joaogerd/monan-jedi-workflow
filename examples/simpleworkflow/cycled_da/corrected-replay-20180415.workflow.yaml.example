    inputs:
      required:
        - "{experiment_dir}/work/obs/2018041518/.monan-jedi-workflow/obs2ioda-validation.json"

  # -------------------------------------------------------------------------
  # Terminal analysis. No MPAS18->00 task exists in this reference scope.
  # -------------------------------------------------------------------------
  - name: jedi18_prepare
    depends_on: [mpas12_gate, obs18_gate]
    argv: [monan-jedi-workflow, jedi-prepare, "{experiment_dir}", --cycle, "2018-04-15T18:00:00Z"]
    inputs:
      required:
