        - "{experiment_dir}/work/obs/2018041512/sondes_obs_2018041512.h5"
        - "{experiment_dir}/work/obs/2018041512/sfc_obs_2018041512.h5"
        - "{experiment_dir}/work/obs/2018041512/gnssro_obs_2018041512.h5"

  - name: obs12_gate
