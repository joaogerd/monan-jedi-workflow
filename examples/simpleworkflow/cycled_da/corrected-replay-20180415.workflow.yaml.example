    outputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T180000Z/run_jedi.pbs"
        - "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-submission.json"

  - name: jedi18_submit
    depends_on: [jedi18_prepare]
    argv: [monan-jedi-workflow, jedi-submit, "{experiment_dir}", --cycle, "2018-04-15T18:00:00Z"]
    outputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-submission.json"

  - name: jedi18_wait
    depends_on: [jedi18_submit]
    argv: [monan-jedi-workflow, jedi-wait, "{experiment_dir}", --cycle, "2018-04-15T18:00:00Z", --poll-seconds, "30"]
    outputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-submission.json"

  - name: jedi18_validate
    depends_on: [jedi18_wait]
    argv: [monan-jedi-workflow, jedi-validate, "{experiment_dir}", --cycle, "2018-04-15T18:00:00Z"]
    outputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-validation.json"
        - "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-artifacts.json"
        - "{experiment_dir}/work/jedi/20180415T180000Z/Data/states/mpas.3dvar.2018-04-15_18.00.00.nc"

  - name: jedi18_gate
    depends_on: [jedi18_validate]
    argv: [monan-jedi-workflow, validation-gate, "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-validation.json"]
    input_fingerprint: sha256
    inputs:
      required:
        - "{experiment_dir}/work/jedi/20180415T180000Z/.monan-jedi-workflow/jedi-validation.json"
