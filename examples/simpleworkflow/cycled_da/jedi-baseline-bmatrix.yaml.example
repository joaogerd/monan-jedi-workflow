# Primeiro teste no JACI: reproduzir o baseline_bmatrix conhecido.
#
# ESTE ARQUIVO NAO E AINDA UM CASO DE CICLAGEM COMPLETO.
# O objetivo e somente provar que o stage JEDI reproduz a analise 2018041500
# usando exatamente o mesmo YAML, background, observacoes e B do baseline que
# ja funciona manualmente.
#
# Depois que este teste passar, substituimos as observacoes pelo Obs2IODA e
# conectamos o forecast MPAS. Nao tente configurar os quatro YAMLs ao mesmo
# tempo na primeira rodada.

jedi:
  cycle:
    step_hours: 6
    background_offset_hours: -3
    window_hours: 6
    first_cycle: "2018-04-15T00:00:00Z"

  variables:
    # Prefixo da compilacao que foi usada no baseline_bmatrix.
    # Confirme com, por exemplo:
    #   readlink -f "$(command -v mpasjedi_variational.x)"
    current_install: /p/projetos/monan_das/USUARIO/builds/monan-jedi-mpas

    baseline_root: /p/projetos/monan_das/USUARIO/manual-tests/baseline_bmatrix

  # O primeiro teste fica isolado do baseline original.
  run_dir: /p/projetos/monan_das/USUARIO/work/CASE/work/jedi/{cycle_id}

  # Crie este skeleton seguindo docs/user/reproduce-baseline-bmatrix.md.
  # Ele contem os arquivos FIXOS do runtime, mas nao background, observacoes,
  # covariance, outputs ou o YAML variacional dependente do experimento.
  runtime:
    skeleton: /p/projetos/monan_das/USUARIO/work/CASE/runtime-skeleton

  # Para o primeiro ciclo usamos EXATAMENTE o background do baseline conhecido.
  # O campo source so sera usado em ciclos posteriores e pode permanecer como
  # contrato futuro enquanto reproduzimos 2018041500.
  background:
    initial_source: "{baseline_root}/Data/background/2018041500/mpasout.2018-04-14_21.00.00.nc"
    source: /p/projetos/monan_das/USUARIO/work/CASE/work/mpas/{previous_cycle_id}/history/mpasout.{background_mpas_file_time}.nc
    target: Data/background/2018041500/mpasout.2018-04-14_21.00.00.nc

  links:
    # B/SABER exatamente como usada no baseline_bmatrix. O YAML variacional
    # continua enxergando Data/covariance/NICAS, HDIAG e VBAL.
    - source: "{baseline_root}/Data/covariance"
      target: Data/covariance

    # Mesmas observacoes do baseline. Nesta fase NAO usamos Obs2IODA ainda.
    - source: "{baseline_root}/Data/ufo/sondes_obs_2018041500_m.nc4"
      target: Data/ufo/sondes_obs_2018041500_m.nc4
    - source: "{baseline_root}/Data/ufo/gnssro_obs_2018041500_s.nc4"
      target: Data/ufo/gnssro_obs_2018041500_s.nc4
    - source: "{baseline_root}/Data/ufo/sfc_obs_2018041500_m.nc4"
      target: Data/ufo/sfc_obs_2018041500_m.nc4

  # Para a primeira reproducao nem sequer alteramos o YAML cientifico:
  # copiamos/renderizamos literalmente a variante que ja funciona.
  templates:
    - source: "{baseline_root}/variants/3dfgat.bmatrix.yaml"
      target: 3dfgat.bmatrix.yaml

  pbs:
    filename: run_jedi.pbs
    job_name: jedi_2018041500
    queue: pesqmini
    select: 1
    ncpus: 64
    mpiprocs: 64
    walltime: "00:30:00"
    launcher: /opt/cray/pals/1.6/bin/mpiexec
    command:
      - "{current_install}/bin/mpasjedi_variational.x"
      - 3dfgat.bmatrix.yaml
    environment:
      OMP_NUM_THREADS: "1"
      FI_CXI_RX_MATCH_MODE: hybrid

  validation:
    log: jedi.stdout.log
    required_log_markers:
      - OOPS Ending

    # O baseline_bmatrix fornecido usa 'mpas.3dvar', nao 'mpas.3dfgat'.
    required_outputs:
      - role: analysis
        path: "Data/states/mpas.3dvar.{analysis_mpas_file_time}.nc"
