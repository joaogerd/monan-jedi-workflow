        - "{experiment_dir}/work/mpas/20180415T120000Z/.monan-jedi-workflow/mpas-validation.json"

  - name: obs18_doctor
    depends_on: [jedi12_gate]
    argv: [monan-jedi-workflow, obs2ioda-doctor, "{experiment_dir}", --cycle, "2018-04-15T18:00:00Z"]
