<streams>
  <immutable_stream name="invariant" type="input" precision="single"
    filename_template="x1.10242.invariant.nc" io_type="pnetcdf,cdf5"
    input_interval="initial_only" />
  <immutable_stream name="input" type="input" precision="single"
    filename_template="mpas.analysis-full.$Y-$M-$D_$h.$m.$s.nc"
    io_type="pnetcdf,cdf5" input_interval="initial_only" />
  <immutable_stream name="da_state" type="output" precision="single"
    io_type="pnetcdf,cdf5" filename_template="mpasout.$Y-$M-$D_$h.$m.$s.nc"
    packages="jedi_da" output_interval="03:00:00" clobber_mode="overwrite"
    filename_interval="output_interval" />
  <stream name="output" type="none" filename_template="history.$Y-$M-$D_$h.$m.$s.nc"
    output_interval="none" />
  <stream name="diagnostics" type="none" filename_template="diag.$Y-$M-$D_$h.$m.$s.nc"
    output_interval="none" />
  <stream name="restart" type="output" filename_template="restart.$Y-$M-$D_$h.$m.$s.nc"
    output_interval="none" />
</streams>
